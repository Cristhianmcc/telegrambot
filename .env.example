# ==========================================
# CONFIGURACIÓN DEL BOT DE TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=tu_token_aqui_de_botfather
TELEGRAM_BOT_MODE=polling # 'polling' para desarrollo local, 'webhook' para producción
PORT=3005

# ==========================================
# CONEXIÓN DIRECTA A JAGUARES (SOLO LECTURA)
# ==========================================
JAGUARES_DB_HOST=localhost
JAGUARES_DB_PORT=3307
JAGUARES_DB_USER=root
JAGUARES_DB_PASSWORD=rootpassword123
JAGUARES_DB_NAME=jaguares_db

# ==========================================
# CONFIGURACIÓN GENERAL
# ==========================================
DEFAULT_TIMEZONE=America/Lima
LOG_LEVEL=info

# ==========================================
# LLM (OPCIONAL - PARA CONSULTAS COMPLEJAS)
# Si no se configuran, el bot opera al 100% con RuleRouter determinista
# ==========================================
LLM_PROVIDER=none # 'openai' | 'gemini' | 'deepseek' | 'none'
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
